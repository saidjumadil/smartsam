<script>
    const lampiranElement = document.getElementById("lampiran-list");
    const lampiransContainer = document.getElementById("lampirans");
    let count = 0

    function addLampiran() {
        const lampiran = lampiranElement.cloneNode(true);
        lampiran.classList.remove("hidden");
        lampiran.querySelector("#lampiran-label").textContent = "Lampiran " + (++count);
        lampiran.querySelector("input").name = "lampiran[]";
        lampiran.querySelector("input").required = true;
        lampiransContainer.appendChild(lampiran);
    }

    function removeLampiran(element) {
        count--;
        lampiransContainer.removeChild(element);
    }
</script>

<script>
    const balas = document.getElementById("balas");

    function showBalas() {
        balas.classList.toggle("hidden");
    }
</script>

<script>
    const catatan = document.getElementById("catatan");
    const pesan = document.getElementById("pesan");

    catatan.addEventListener("change", function () {
        if (catatan.value == 'Pesan Lainnya') {
            pesan.classList.remove("hidden");
        } else {
            pesan.classList.add("hidden");
        }
    })
</script>
