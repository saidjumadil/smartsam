                            <div class="stat-value">90%</div>
                            <div class="stat-label">Lebih Efisien</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">24/7</div>
                            <div class="stat-label">Akses Kapanpun</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-value">100%</div>
