                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <path d="m9 11 3 3L22 4" />
                            </svg>
                            <span class="benefit-text">Mempercepat proses persetujuan dan distribusi surat</span>
                        </li>
                        <li class="benefit-item">
                            <svg class="benefit-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <path d="m9 11 3 3L22 4" />
                            </svg>
                            <span class="benefit-text">Memudahkan pencarian dan pengarsipan dokumen</span>
                        </li>
                        <li class="benefit-item">
                            <svg class="benefit-icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                                viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                                stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <path d="m9 11 3 3L22 4" />
                            </svg>
                            <span class="benefit-text">Meningkatkan keamanan dan kerahasiaan dokumen</span>
                        </li>
                    </ul>
                </div>

                <div class="stats-card">
                    <div class="stats-grid">
